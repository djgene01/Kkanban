@using Kkanban.Data.Models
@using Kkanban.Services
@inject ICardService CardService
@inject IBoardService BoardService

<div class="min-w-[280px] w-72 flex-shrink-0">
    <div class="bg-slate-800 rounded-xl shadow-xl overflow-hidden border border-slate-700/50">
        <!-- Column Header -->
        <div class="bg-gradient-to-r from-slate-700 to-slate-600 p-4 border-b border-slate-700/50">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-white font-semibold text-lg flex items-center gap-2">
                    <span class="bg-indigo-500 text-white text-xs px-2 py-0.5 rounded-full min-w-[1.5rem] text-center">@Cards.Count()</span>
                    @ColumnItem.Title
                    @if (IsDoneColumn)
                    {
                        <span class="text-green-400 text-sm">✓</span>
                    }
                </h3>
                <div class="flex gap-1">
                    <button class="w-8 h-8 flex items-center justify-center bg-slate-600/50 hover:bg-slate-600 rounded-lg transition-colors duration-200 text-slate-300 hover:text-white" title="Add Card" @onclick="@(() => ShowEditor("card"))">+</button>
                    <button class="w-8 h-8 flex items-center justify-center bg-slate-600/50 hover:bg-slate-600 rounded-lg transition-colors duration-200 text-slate-300 hover:text-white" title="Edit Column" @onclick="@(() => ShowEditor("column"))">✎</button>
                </div>
            </div>
        </div>

        <!-- Card List -->
        <div class="p-3 space-y-3 min-h-[100px] overflow-y-auto max-h-[calc(100vh-250px)] custom-scrollbar" data-column-cards="@ColumnItem.Id">
            @if (!Cards.Any())
            {
                <div class="text-center py-8">
                    <p class="text-slate-500 text-sm mb-3">No cards</p>
                    <button class="px-3 py-1.5 bg-slate-700/50 hover:bg-slate-700 text-slate-400 hover:text-white text-sm rounded-lg transition-colors duration-200" @onclick="@(() => ShowEditor("card"))">+ Add a card</button>
                </div>
            }
            else
            {
                @foreach (var card in Cards.OrderBy(c => c.Order))
                {
                    <KanbanCardView CardItem="@card"
                          ColumnTitle="@ColumnItem.Title"
                          OnEditRequested="@(() => OnCardEditRequested(card.Id))"
                          OnArchiveRequested="@(() => OnArchiveCard(card.Id))" />
                }
            }
        </div>

        <!-- Editor Modal -->
        @if (editorState != null)
        {
            <div class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50" @onclick="CloseEditor">
                <div class="bg-slate-800 rounded-xl shadow-2xl w-full max-w-md mx-4" @onclick:stopPropagation>
                    <div class="flex items-center justify-between p-6 border-b border-slate-700">
                        <h3 class="text-xl font-semibold text-white">@(editorState.type == "column" ? "Edit Column" : "Edit Card")</h3>
                        <button class="text-slate-400 hover:text-white text-2xl leading-none" @onclick="CloseEditor">&times;</button>
                    </div>
                    <div class="p-6">
                        @if (editorState.type == "column")
                        {
                            <div class="mb-4">
                                <label for="columnName" class="block text-sm font-medium text-slate-300 mb-2">Column Name</label>
                                <input type="text" id="columnName" @bind="editorState.columnTitle" @bind:event="oninput" placeholder="Enter column name" maxlength="100" 
                                       class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                            </div>
                        }
                        else if (editorState.card != null)
                        {
                            <div class="mb-4">
                                <label for="cardTitle" class="block text-sm font-medium text-slate-300 mb-2">Title *</label>
                                <input type="text" id="cardTitle" @bind="editorState.card.Title" @bind:event="oninput" placeholder="Enter card title" maxlength="200" 
                                       class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                            </div>
                            <div class="mb-4">
                                <label for="cardDescription" class="block text-sm font-medium text-slate-300 mb-2">Description</label>
                                <textarea id="cardDescription" @bind="editorState.card.Description" @bind:event="oninput" placeholder="Add a description..." rows="4" maxlength="2000"
                                          class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none"></textarea>
                            </div>
                            <div class="mb-4">
                                <label for="cardAssignee" class="block text-sm font-medium text-slate-300 mb-2">Assignee</label>
                                <input type="text" id="cardAssignee" @bind="editorState.card.Assignee" @bind:event="oninput" placeholder="e.g. John Doe" maxlength="100" 
                                       class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                            </div>
                        }
                    </div>
                    <div class="flex justify-end gap-3 p-6 border-t border-slate-700">
                        <button class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-lg transition-colors duration-200" @onclick="CloseEditor">Cancel</button>
                        <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200" @onclick="SaveEditor">Save</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public BoardColumn ColumnItem { get; set; } = default!;
    [Parameter] public IEnumerable<KanbanCard> Cards { get; set; } = Enumerable.Empty<KanbanCard>();
    [Parameter] public EventCallback<int> OnCardMoved { get; set; }
    [Parameter] public EventCallback<int> OnCardArchived { get; set; }

    private bool IsDoneColumn => ColumnItem.Title.Contains("Done", StringComparison.OrdinalIgnoreCase);
    private EditorState? editorState;

    private void ShowEditor(string type, KanbanCard? card = null)
    {
        if (type == "column")
        {
            editorState = new EditorState { type = "column", columnTitle = ColumnItem.Title };
        }
        else
        {
            if (card != null)
            {
                editorState = new EditorState
                {
                    type = "card",
                    card = new KanbanCard
                    {
                        Id = card.Id,
                        Title = card.Title,
                        Description = card.Description,
                        Assignee = card.Assignee,
                        BoardColumnId = card.BoardColumnId,
                        CardLabels = card.CardLabels?.ToList() ?? new List<CardLabel>(),
                        Order = card.Order
                    }
                };
            }
            else
            {
                editorState = new EditorState { type = "card", card = new KanbanCard { BoardColumnId = ColumnItem.Id } };
            }
        }
    }

    private void CloseEditor()
    {
        editorState = null;
    }

    private async Task OnCardEditRequested(int cardId)
    {
        var card = await CardService.GetCardAsync(cardId);
        if (card != null)
        {
            ShowEditor("card", card);
        }
    }

    private async Task SaveEditor()
    {
        if (editorState != null)
        {
            if (editorState.type == "column")
            {
                await BoardService.RenameColumnAsync(ColumnItem.Id, editorState.columnTitle!);
            }
            else if (editorState.card != null)
            {
                if (editorState.card.Id == 0)
                {
                    var labelIds = editorState.card.CardLabels?.Select(cl => cl.LabelId).ToArray() ?? Array.Empty<int>();
                    await CardService.CreateCardAsync(ColumnItem.Id, editorState.card.Title, editorState.card.Description, editorState.card.Assignee, labelIds);
                }
                else
                {
                    var labelIds = editorState.card.CardLabels?.Select(cl => cl.LabelId).ToArray() ?? Array.Empty<int>();
                    await CardService.UpdateCardAsync(editorState.card, labelIds);
                }
                await LoadBoardData();
            }
        }
        CloseEditor();
    }

    private async Task OnArchiveCard(int cardId)
    {
        await CardService.ArchiveCardAsync(cardId);
        await OnCardArchived.InvokeAsync(cardId);
        await LoadBoardData();
    }

    private async Task LoadBoardData()
    {
        var updatedCards = await CardService.GetCardsByColumnAsync(ColumnItem.Id);
        Cards = updatedCards;
        StateHasChanged();
    }

    private class EditorState
    {
        public string type = "";
        public string? columnTitle;
        public KanbanCard? card;
    }
}
